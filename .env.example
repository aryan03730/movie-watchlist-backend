# Copy this file to .env and fill in the values:  cp .env.example .env
# .env is git-ignored. Never commit real secrets.

# Used when you run the app WITHOUT Docker. Docker Compose sets its own DATABASE_URL
# pointing at the db container, so this value is ignored there.
DATABASE_URL=postgresql://postgres:pass@localhost:5432/watchlist

# Signs login tokens. Use a long random string. Generate one with:
#   python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=replace-me-with-a-long-random-string

# Free key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=replace-me-with-your-tmdb-key

# 1 = Flask debug mode (local development), 0 = off
DEBUG=1
